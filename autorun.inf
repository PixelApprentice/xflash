; Xflash Laptop Diagnostics - USB Portable AutoRun Configuration
; -----------------------------------------------------------------
; When inserted on Windows 8, 10, 11, this configures the drive's
; label, icon, and right-click AutoPlay action in Windows Explorer.
; -----------------------------------------------------------------

[autorun]
open=start-xflash.bat
icon=aegis.ico
label=Xflash Hardware Diagnostics (Run Me)
action=Run Xflash Laptop Diagnostics
shell\run=Run Xflash Diagnostics
shell\run\command=start-xflash.bat
